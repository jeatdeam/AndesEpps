generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: pooler de supabase (puerto 6543) que usa el backend
// DIRECT_URL: conexion de sesion (puerto 5432) que usa prisma migrate para crear y cambiar tablas
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Producto {
  id                    Int       @id @default(autoincrement())
  // nombre y categoria forman la url publica (/productos/categoria/nombre)
  name                  String    @unique
  precio                Decimal   @db.Decimal(10, 2)
  stock                 Int
  img                   String[]
  descripcionPrimaria   String
  descripcionSecundaria String[]
  caracteristicas       String[]
  informacionAdicional  String[]
  categoria             String
  marca                 String?
  normas                String[]
  tallas                String[]
  colores               String[]
  material              String?
  // porcentaje sobre el precio; 0 = no esta en oferta
  descuento             Int       @default(0)
  // los productos iniciales no tienen fecha; los creados desde el dashboard si (definen los "nuevos ingresos")
  creadoEn              DateTime?
  calificacion          Float?
  resenas               Int?
  banners               Banner[]

  @@index([categoria])
}

// una fila por posicion ocupada; una posicion sin fila usa el banner automatico
model Banner {
  posicion   String    @id
  imagen     String
  titulo     String    @default("")
  categoria  String?
  // si se borra el producto el banner pasa a llevar a todas las ofertas
  productoId Int?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
}

model Cotizacion {
  // el id numera las cotizaciones (COT-000001) sin repetirse aunque lleguen dos a la vez
  id             Int      @id @default(autoincrement())
  numero         String   @unique
  // nombre del pdf con una parte aleatoria para que no se pueda adivinar la url de otra cotizacion
  archivo        String   @unique
  fecha          DateTime @default(now())
  cliente        Json
  items          Json
  total          Decimal  @db.Decimal(12, 2)
  enviosCorreo   Int      @default(0)
  enviosWhatsapp Int      @default(0)
}

// usuarios que pueden entrar al dashboard
model Administrador {
  id         Int      @id @default(autoincrement())
  correo     String   @unique
  // hash bcrypt, nunca la contraseña en texto
  contrasena String
  nombre     String   @default("")
  creadoEn   DateTime @default(now())
}
