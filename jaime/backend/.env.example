# copia estas variables a backend/.env y completa las que vayas a usar.
# si un canal no esta configurado la cotizacion igual se genera y se puede descargar.

# direccion publica de la tienda (enlaces del correo y origen permitido para el dashboard; varias separadas por coma)
URL_TIENDA=http://localhost:3000

# ---------- base de datos (Supabase > Connect > ORMs > Prisma) ----------
# pooler (puerto 6543) que usa el backend
DATABASE_URL="postgresql://postgres.xxxx:CONTRASEÑA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# conexion de sesion (puerto 5432) para crear y cambiar tablas: npx prisma migrate deploy
DIRECT_URL="postgresql://postgres.xxxx:CONTRASEÑA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------- sesion del dashboard ----------
# clave larga y aleatoria: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=
# solo si la tienda y el backend quedan en dominios distintos (ej. vercel.app y onrender.com): none (requiere https)
COOKIE_SAMESITE=

# ---------- imagenes (Cloudinary > Settings > API Keys) ----------
# si faltan, las imagenes se guardan en backend/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# carpeta principal en cloudinary (adentro se crean productos/ y banners/)
CLOUDINARY_CARPETA=los-andes

# ---------- correo (SMTP) ----------
# Gmail: smtp.gmail.com, puerto 465 y una "contraseña de aplicación" (no la contraseña normal)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# remitente que ve el cliente, ej. "Los Andes J & C <ventas@tuempresa.com>" (por defecto SMTP_USER)
CORREO_REMITENTE=
# opcional: recibe una copia oculta de cada cotizacion
CORREO_VENTAS=

# ---------- WhatsApp Business Cloud API (Meta) ----------
# se obtienen en developers.facebook.com > tu app > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Meta solo deja enviar mensajes libres si el cliente te escribio en las ultimas 24 h.
# para escribirle primero crea una plantilla aprobada con encabezado de tipo DOCUMENTO
# y cuerpo con {{1}} = nombre del cliente y {{2}} = numero de cotizacion, y pon aqui su nombre
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=es
